# Root Environment Variables Example
# Duplicate this file to .env or inside client/.env and server/.env as needed.

# Frontend (Client) Placeholders
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your_firebase_auth_domain_here"
VITE_FIREBASE_PROJECT_ID="your_firebase_project_id_here"
VITE_FIREBASE_STORAGE_BUCKET="your_firebase_storage_bucket_here"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_firebase_messaging_sender_id_here"
VITE_FIREBASE_APP_ID="your_firebase_app_id_here"
VITE_GOOGLE_CLIENT_ID="your_google_client_id_here"

# Backend (Server) Placeholders
SECRET_KEY="your_jwt_secret_key_here"
GROQ_API_KEY="your_groq_api_key_here"
RAPIDAPI_KEY="your_rapidapi_key_here"
FIREBASE_SERVICE_ACCOUNT_PATH="your_path_to_firebase_service_account_json_here"
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="your_twilio_phone_number_here"
