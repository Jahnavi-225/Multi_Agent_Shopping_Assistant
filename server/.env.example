# =====================================================================
# ShopWiseAI Backend Environment Variables (Secret Keys & LLM/SMS APIs)
# =====================================================================

# Flask JWT Secret Key
SECRET_KEY="your_flask_jwt_secret_key_here"

# Groq LLM API Key (Free fast LLM inference)
GROQ_API_KEY="your_groq_api_key_here"

# RapidAPI Real-Time Amazon Data Key
RAPIDAPI_KEY="your_rapidapi_key_here"

# Firebase Admin SDK Credentials
# Option A: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH="path/to/serviceAccountKey.json"

# Twilio SMS API Keys (Optional Backend SMS Provider)
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+10000000000"
